# ==============================================================================
# ACADEMIC ASSISTANT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase Backend Credentials
# Find these in your Supabase Project: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. AI Assistant API Key (Choose either Gemini or NVIDIA)
# Option A (Recommended): Google Gemini API Key (Free at https://aistudio.google.com/)
GEMINI_API_KEY=

# Option B: NVIDIA NIM API Key (https://build.nvidia.com/)
NVIDIA_API_KEY=

